rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 0. GLOBAL SAFETY NET (DEFAULT-DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. REUSABLE PRIMITIVES & IDENTITY HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Secure Admin Validation with Email Verification and Document Checks
    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
         request.auth.token.email is string &&
         request.auth.token.email.lower() == 'aanews70@gmail.com' &&
         'email_verified' in request.auth.token &&
         request.auth.token.email_verified == true) ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // Staff Role Check
    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'staff')
      );
    }

    // Delivery Personnel Role Check (identity-verified via claims, staff roster, or user doc)
    function isDeliveryPersonnel() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'delivery' ||
        request.auth.token.get('delivery', false) == true ||
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['delivery', 'staff', 'admin'])
      );
    }

    function isValidLatLng(loc) {
      return loc is map &&
        loc.lat is number && loc.lng is number &&
        loc.lat >= -90 && loc.lat <= 90 &&
        loc.lng >= -180 && loc.lng <= 180;
    }

    // Vendor Role Check (Identity-verified, never trusted from client)
    function isVendor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'vendor' ||
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'vendor')
      );
    }

    function isVendorOwner(vendorId) {
      return isSignedIn() && (
        isAdmin() ||
        (isVendor() && (
          request.auth.uid == vendorId ||
          (exists(/databases/$(database)/documents/vendors/$(vendorId)) &&
           get(/databases/$(database)/documents/vendors/$(vendorId)).data.get('ownerUserId', '') == request.auth.uid)
        ))
      );
    }

    function isValidVendorApplication(data) {
      return data.keys().hasAll(['userId', 'shopName', 'contactName', 'phone', 'email', 'status', 'submittedAt']) &&
        data.keys().hasOnly([
          'userId', 'shopName', 'contactName', 'phone', 'email',
          'fssaiLicense', 'gstNumber', 'status', 'submittedAt',
          'reviewedAt', 'reviewedBy', 'rejectionReason', 'updatedAt'
        ]) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.shopName is string && data.shopName.size() > 0 && data.shopName.size() <= 150 &&
        data.contactName is string && data.contactName.size() > 0 && data.contactName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.status is string && data.status in ['pending', 'approved', 'rejected'] &&
        data.submittedAt is string && data.submittedAt.size() <= 64 &&
        (!('fssaiLicense' in data) || (data.fssaiLicense is string && data.fssaiLicense.size() <= 50)) &&
        (!('gstNumber' in data) || (data.gstNumber is string && data.gstNumber.size() <= 50)) &&
        (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() <= 64)) &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
        (!('rejectionReason' in data) || (data.rejectionReason is string && data.rejectionReason.size() <= 500));
    }

    function isValidMediaRegistry(data) {
      return data.keys().hasAll([
          'id', 'downloadUrl', 'storagePath', 'fileName', 'size',
          'contentType', 'uploadedAt', 'preset', 'uploadedBy', 'status', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'downloadUrl', 'thumbnailUrl', 'storagePath', 'thumbnailStoragePath',
          'fileName', 'size', 'originalSize', 'savingsPercentage', 'width', 'height',
          'contentType', 'uploadedAt', 'preset', 'entityId', 'uploadedBy',
          'uploadedByEmail', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.downloadUrl is string && data.downloadUrl.size() > 0 && data.downloadUrl.size() <= 2000 &&
        data.storagePath is string && data.storagePath.size() > 0 && data.storagePath.size() <= 500 &&
        data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255 &&
        data.size is number && data.size >= 0 && data.size <= 52428800 &&
        data.contentType is string && data.contentType.size() > 0 && data.contentType.size() <= 100 &&
        data.uploadedAt is string && data.uploadedAt.size() <= 64 &&
        data.preset is string && data.preset.size() > 0 && data.preset.size() <= 64 &&
        data.uploadedBy is string && data.uploadedBy.size() > 0 && data.uploadedBy.size() <= 128 &&
        data.status is string && data.status in ['active', 'archived', 'deleted'] &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2000)) &&
        (!('thumbnailStoragePath' in data) || (data.thumbnailStoragePath is string && data.thumbnailStoragePath.size() <= 500)) &&
        (!('originalSize' in data) || (data.originalSize is number && data.originalSize >= 0)) &&
        (!('savingsPercentage' in data) || (data.savingsPercentage is number && data.savingsPercentage >= 0 && data.savingsPercentage <= 100)) &&
        (!('width' in data) || (data.width is number && data.width >= 0)) &&
        (!('height' in data) || (data.height is number && data.height >= 0)) &&
        (!('entityId' in data) || (data.entityId is string && data.entityId.size() <= 128)) &&
        (!('uploadedByEmail' in data) || (data.uploadedByEmail is string && data.uploadedByEmail.size() <= 200));
    }

    // Connectivity verification route
    match /test/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. CORE E-COMMERCE COLLECTIONS
    // =========================================================================

    // Users: Profiles and Secure Role Guarding
    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff() || isAdmin();
      allow list: if isStaff() || isAdmin();
      
      // Customer or vendor can register own profile with default role, never admin/staff
      allow create: if isOwner(userId) && isValidId(userId) && (
        (incoming().role in ['customer', 'vendor'] &&
         (!('isAdmin' in incoming()) || incoming().isAdmin == false) &&
         (!('isStaff' in incoming()) || incoming().isStaff == false)) ||
        isAdmin()
      );
      
      // Client cannot elevate role, admin status, or permissions
      allow update: if (
        isOwner(userId) &&
        incoming().role == existing().role &&
        (!('isAdmin' in incoming()) || incoming().isAdmin == existing().get('isAdmin', false)) &&
        (!('isStaff' in incoming()) || incoming().isStaff == existing().get('isStaff', false)) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'defaultAddressId', 'updatedAt', 'preferences', 'addresses', 'photoURL', 'avatarUrl', 'authMethod', 'emailVerified'])
      ) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Admins: Explicit admin role registry
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list, write: if isAdmin();
    }

    // Addresses: Customer delivery address book
    match /addresses/{addressId} {
      allow get: if (isSignedIn() && existing().userId == request.auth.uid) || isStaff() || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isStaff() || isAdmin();
      
      allow create: if isSignedIn() && isValidId(addressId) &&
        incoming().userId == request.auth.uid &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
        incoming().phone is string && incoming().phone.size() >= 10 && incoming().phone.size() <= 15 &&
        incoming().pincode is string && incoming().pincode.size() >= 4 && incoming().pincode.size() <= 10 &&
        incoming().addressLine is string && incoming().addressLine.size() <= 300;
        
      allow update: if (
        isSignedIn() && existing().userId == request.auth.uid &&
        incoming().userId == existing().userId
      ) || isAdmin();
      
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // Categories: Public taxonomy catalog
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: Public catalog, managed by Admin and verified Vendors for own catalog
    match /products/{productId} {
      allow read: if true;
      
      allow create: if isValidId(productId) && (
        isAdmin() ||
        (isVendor() && incoming().vendorId == request.auth.uid && incoming().status in ['active', 'draft'])
      );
      
      allow update: if (
        isAdmin() ||
        (isVendor() && existing().vendorId == request.auth.uid && incoming().vendorId == request.auth.uid)
      );
      
      allow delete: if isAdmin();
    }

    // Product Variants: Size/weight package options
    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if isAdmin() || isVendor();
    }

    // Inventory: Stock tracking
    match /inventory/{inventoryId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin() || isVendor();
    }

    // Carts: Customer active shopping cart isolation
    match /carts/{cartId} {
      allow read: if isOwner(cartId) || (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow create, update: if (
        (isOwner(cartId) || (isSignedIn() && incoming().userId == request.auth.uid)) &&
        incoming().items is list && incoming().items.size() <= 50
      ) || isAdmin();
      allow delete: if isOwner(cartId) || (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // Wishlists: Customer saved items isolation
    match /wishlists/{wishlistId} {
      allow read: if isOwner(wishlistId) || (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow create, update: if (
        (isOwner(wishlistId) || (isSignedIn() && incoming().userId == request.auth.uid)) &&
        incoming().productIds is list && incoming().productIds.size() <= 100
      ) || isAdmin();
      allow delete: if isOwner(wishlistId) || (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // Orders: Multi-party lifecycle with strict Customer, Vendor, Delivery Rider & Staff/Admin isolation
    match /orders/{orderId} {
      // Customer can read only own orders; Vendor if assigned; Delivery Rider if assignedDeliveryId matches; Staff/Admin full access
      allow get: if (isSignedIn() && existing().customerId == request.auth.uid) ||
                    (isVendor() && existing().get('vendorId', '') == request.auth.uid) ||
                    (isDeliveryPersonnel() && existing().get('assignedDeliveryId', '') == request.auth.uid) ||
                    isStaff() || isAdmin();
                    
      allow list: if (isSignedIn() && resource.data.customerId == request.auth.uid) ||
                     (isVendor() && resource.data.get('vendorId', '') == request.auth.uid) ||
                     (isDeliveryPersonnel() && resource.data.get('assignedDeliveryId', '') == request.auth.uid) ||
                     isStaff() || isAdmin();

      // Customer can create valid order only through approved workflow
      allow create: if isSignedIn() && isValidId(orderId) &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'PLACED' &&
        incoming().subtotal is number && incoming().subtotal > 0 &&
        incoming().total is number && incoming().total > 0 &&
        incoming().orderNumber is string && incoming().orderNumber.size() <= 50 &&
        incoming().customerName is string && incoming().customerName.size() <= 100 &&
        incoming().customerPhone is string && incoming().customerPhone.size() >= 10 && incoming().customerPhone.size() <= 15;

      // Customer can only cancel pre-dispatch; Assigned Delivery Rider can only progress assigned active delivery; Staff/Admin full update
      allow update: if (
        isSignedIn() &&
        existing().customerId == request.auth.uid &&
        incoming().customerId == existing().customerId &&
        incoming().total == existing().total &&
        incoming().subtotal == existing().subtotal &&
        incoming().status == 'CANCELLED' &&
        existing().status in ['PLACED', 'Order Placed', 'CONFIRMED'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'notes', 'statusHistory'])
      ) || (
        isDeliveryPersonnel() &&
        existing().get('assignedDeliveryId', '') == request.auth.uid &&
        incoming().customerId == existing().customerId &&
        incoming().total == existing().total &&
        incoming().subtotal == existing().subtotal &&
        incoming().get('assignedDeliveryId', '') == existing().get('assignedDeliveryId', '') &&
        existing().status in [
          'PLACED', 'Order Placed',
          'CONFIRMED', 'Confirmed',
          'PREPARING', 'Preparing',
          'PACKED', 'Packed',
          'OUT_FOR_DELIVERY', 'Out for Delivery'
        ] &&
        incoming().status in ['OUT_FOR_DELIVERY', 'Out for Delivery', 'DELIVERED', 'Delivered'] &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'statusHistory', 'trackingActive'])
      ) || isStaff() || isAdmin();

      allow delete: if isAdmin();
    }

    // Order Items: Normalized line items (protected by order customer & vendor derivation)
    match /orderItems/{itemId} {
      allow get: if isSignedIn() && (
        isAdmin() || isStaff() ||
        (exists(/databases/$(database)/documents/orders/$(existing().orderId)) &&
         (get(/databases/$(database)/documents/orders/$(existing().orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(existing().orderId)).data.get('vendorId', '') == request.auth.uid))
      );
      
      allow list: if isSignedIn() && (
        isAdmin() || isStaff() ||
        resource.data.get('customerId', '') == request.auth.uid ||
        (isVendor() && resource.data.get('vendorId', '') == request.auth.uid)
      );
      
      allow create: if isSignedIn() && isValidId(itemId) && (
        isAdmin() || isStaff() ||
        (exists(/databases/$(database)/documents/orders/$(incoming().orderId)) &&
         get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.customerId == request.auth.uid)
      );
      
      allow update, delete: if isStaff() || isAdmin();
    }

    // Order Status History: Status audit log
    match /orderStatusHistory/{historyId} {
      allow get: if isSignedIn() && (
        isAdmin() || isStaff() ||
        (exists(/databases/$(database)/documents/orders/$(existing().orderId)) &&
         (get(/databases/$(database)/documents/orders/$(existing().orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(existing().orderId)).data.get('vendorId', '') == request.auth.uid))
      );
      allow list: if isSignedIn() && (
        isAdmin() || isStaff() ||
        resource.data.get('updatedBy', '') == request.auth.uid
      );
      allow create: if isSignedIn() || isStaff() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Payments: Sensitive financial records (Protected against client tampering)
    match /payments/{paymentId} {
      allow get: if (isSignedIn() && existing().customerId == request.auth.uid) || isStaff() || isAdmin();
      allow list: if (isSignedIn() && resource.data.customerId == request.auth.uid) || isStaff() || isAdmin();
      
      // Initial client intent can only record 'Pending' payment for own customer order; status changes must be Cloud Functions / Admin
      allow create: if (
        isSignedIn() &&
        incoming().customerId == request.auth.uid &&
        incoming().status == 'Pending' &&
        incoming().amount is number && incoming().amount > 0
      ) || isAdmin();
      
      // Updates and deletions restricted to Cloud Functions / Admin
      allow update, delete: if isAdmin();
    }

    // Coupons: Promotional codes catalog
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupon Usage: Usage redemption tracking
    match /couponUsage/{usageId} {
      allow get: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Reviews: Customer product feedback with author validation
    match /reviews/{reviewId} {
      allow read: if true;
      
      // Customers can create reviews only for eligible items with their own identity
      allow create: if isSignedIn() && isValidId(reviewId) &&
        incoming().customerId == request.auth.uid &&
        incoming().productId is string && incoming().productId.size() <= 100 &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
        ((incoming().comment is string && incoming().comment.size() <= 2000) ||
         (incoming().reviewText is string && incoming().reviewText.size() <= 2000));
        
      allow update: if (
        isSignedIn() &&
        existing().customerId == request.auth.uid &&
        incoming().customerId == existing().customerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewText', 'comment', 'title', 'updatedAt'])
      ) || isAdmin();
      
      allow delete: if (isSignedIn() && existing().customerId == request.auth.uid) || isAdmin();
    }

    // Delivery Areas: Serviceable pincodes
    match /deliveryAreas/{areaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery Slots: Dispatch time windows
    match /deliverySlots/{slotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners: Visual marketing promos
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers: Campaign deals
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications: User notification center
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && ((isSignedIn() && existing().userId == request.auth.uid) || isStaff() || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isStaff() || isAdmin();
      
      allow create: if isValidId(notificationId) && (
        isAdmin() || isStaff() || (
          isSignedIn() &&
          incoming().userId == request.auth.uid &&
          incoming().read == false &&
          incoming().type in ['order', 'system'] &&
          incoming().category in ['order_confirmation', 'payment_status', 'cancellation'] &&
          incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200 &&
          incoming().message is string && incoming().message.size() > 0 && incoming().message.size() <= 1000 &&
          (!('link' in incoming()) || (incoming().link is string && incoming().link.size() <= 300))
        )
      );

      allow update: if isValidId(notificationId) && ((
        isSignedIn() && existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
      ) || isAdmin());
      
      allow delete: if isValidId(notificationId) && (isAdmin() || isStaff());
    }

    // Site Settings: Store configurations
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage Configuration
    match /homepageConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Broadcast Notifications
    match /broadcastNotifications/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin() || isStaff();
    }

    // Staff Roster
    match /staff/{staffId} {
      allow get: if isStaff() || isAdmin() || (
        isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        existing().get('email', '').lower() == request.auth.token.email.lower()
      );
      allow list: if isStaff() || isAdmin() || (
        isSignedIn() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        resource.data.email == request.auth.token.email.lower()
      );
      allow write: if isAdmin();
    }

    // Reports & Analytics Records
    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }

    // Media Registry: Storage upload tracking & cleanup audit records
    match /mediaRegistry/{mediaId} {
      allow get: if isValidId(mediaId) && (
        isAdmin() ||
        (isSignedIn() && existing().uploadedBy == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.uploadedBy == request.auth.uid);

      allow create: if isSignedIn() && isValidId(mediaId) &&
        isValidMediaRegistry(incoming()) &&
        (isAdmin() || (incoming().uploadedBy == request.auth.uid && incoming().status == 'active'));

      allow update: if isValidId(mediaId) && isValidMediaRegistry(incoming()) && (
        isAdmin() ||
        (isSignedIn() &&
         existing().uploadedBy == request.auth.uid &&
         incoming().uploadedBy == existing().uploadedBy &&
         incoming().createdAt == existing().createdAt &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'entityId', 'updatedAt']))
      );

      allow delete: if isValidId(mediaId) && (
        isAdmin() ||
        (isSignedIn() && existing().uploadedBy == request.auth.uid)
      );
    }

    // =========================================================================
    // 3. FUTURE MARKETPLACE COLLECTIONS (ZERO-TRUST VENDOR ISOLATION)
    // =========================================================================

    // Vendor Applications: Prospective seller onboarding queue (PII protected)
    match /vendorApplications/{appId} {
      allow get: if isValidId(appId) && (isOwner(appId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() && isValidId(appId) &&
        isValidVendorApplication(incoming()) &&
        (isAdmin() || (appId == request.auth.uid && incoming().userId == request.auth.uid && incoming().status == 'pending'));

      allow update: if isValidId(appId) && isValidVendorApplication(incoming()) && (
        isAdmin() ||
        (isOwner(appId) &&
         existing().userId == request.auth.uid &&
         incoming().userId == existing().userId &&
         existing().status == 'pending' &&
         incoming().status == 'pending' &&
         incoming().diff(existing()).affectedKeys().hasOnly(['shopName', 'contactName', 'phone', 'fssaiLicense', 'gstNumber', 'submittedAt']))
      );

      allow delete: if isValidId(appId) && isAdmin();
    }

    // Vendors: Seller business profiles
    match /vendors/{vendorId} {
      allow read: if true; // Public verified vendor profiles
      allow create: if isSignedIn() && (
        incoming().ownerUserId == request.auth.uid || isAdmin()
      );
      allow update: if (
        isSignedIn() &&
        existing().ownerUserId == request.auth.uid &&
        incoming().ownerUserId == existing().ownerUserId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'storeDescription', 'phone', 'address', 'logoUrl', 'updatedAt'])
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Vendor Users: Merchant team members
    match /vendorUsers/{vendorUserId} {
      allow get: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Vendor Profiles: Public storefront data
    match /vendorProfiles/{profileId} {
      allow read: if true;
      allow write: if isVendor() || isAdmin();
    }

    // Vendor Products: Vendor catalog submission (Strict Vendor A vs B isolation)
    match /vendorProducts/{productId} {
      allow get: if isVendorOwner(existing().vendorId) || isStaff() || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isStaff() || isAdmin();
      
      allow create: if isVendor() && isValidId(productId) &&
        incoming().vendorId == request.auth.uid;
        
      allow update: if (
        isVendor() &&
        existing().vendorId == request.auth.uid &&
        incoming().vendorId == existing().vendorId
      ) || isAdmin();
      
      allow delete: if (isVendor() && existing().vendorId == request.auth.uid) || isAdmin();
    }

    // Vendor Inventory: Seller batch control (Strict Vendor A vs B isolation)
    match /vendorInventory/{invId} {
      allow get: if isVendorOwner(existing().vendorId) || isStaff() || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isStaff() || isAdmin();
      
      allow create: if isVendor() && isValidId(invId) &&
        incoming().vendorId == request.auth.uid;
        
      allow update: if (
        isVendor() &&
        existing().vendorId == request.auth.uid &&
        incoming().vendorId == existing().vendorId
      ) || isAdmin();
      
      allow delete: if (isVendor() && existing().vendorId == request.auth.uid) || isAdmin();
    }

    // Vendor Orders: Split fulfillment orders (Strict Vendor A vs B isolation)
    match /vendorOrders/{vOrderId} {
      allow get: if isVendorOwner(existing().vendorId) || isStaff() || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isStaff() || isAdmin();
      
      // Vendors can only update fulfillment state of their own sub-orders
      allow update: if (
        isVendor() &&
        existing().vendorId == request.auth.uid &&
        incoming().vendorId == existing().vendorId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fulfillmentStatus', 'shippingCourier', 'trackingNumber', 'updatedAt', 'notes'])
      ) || isStaff() || isAdmin();
      
      // Order dispatch creation managed through server/Cloud Functions or Admin
      allow create, delete: if isStaff() || isAdmin();
    }

    // Vendor Commissions: Marketplace ledger (Financial: Client write strictly denied)
    match /vendorCommissions/{commId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      // Sensitive financial operations: Cloud Functions / Admin only
      allow write: if false;
    }

    // Vendor Payouts: Merchant bank settlements (Admin/Server disbursement only; vendors strictly denied)
    match /vendorPayouts/{payoutId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Vendor Bank Accounts: Payout coordinates (Strict Vendor isolation)
    match /vendorBankAccounts/{accId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      
      allow create: if isVendor() && isValidId(accId) &&
        incoming().vendorId == request.auth.uid;
        
      allow update: if (
        isVendor() &&
        existing().vendorId == request.auth.uid &&
        incoming().vendorId == existing().vendorId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['accountNumber', 'ifscCode', 'bankName', 'accountHolderName', 'updatedAt'])
      ) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Vendor Notifications: Seller portal alerts (Strict Vendor isolation)
    match /vendorNotifications/{notifId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      
      allow update: if (
        isVendor() &&
        existing().vendorId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
      ) || isAdmin();
      
      allow create, delete: if isAdmin();
    }

    // Commission Rules: Global, category, vendor, product commission schedules
    match /commissionRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Financial Ledger: Immutable auditable ledger (Vendor can never modify, cannot view another vendor's ledger)
    match /financialLedger/{entryId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      // Immutable audit records created exclusively by server / Cloud Functions
      allow write: if false;
    }

    // Vendor Financial Summaries: Aggregated earnings & balances (Vendor can never tamper with earnings)
    match /vendorFinancialSummaries/{vendorId} {
      allow get: if isVendorOwner(vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 4. VENDOR ADVERTISING MODULE (PHASE 1 FOUNDATION)
    // Strict isolation: Vendor A can NEVER read Vendor B's campaigns, wallets,
    // transactions, clicks, or reports.
    // Admins retain full administrative authorization.
    // =========================================================================

    // Advertising Campaigns: Promotional campaigns created and managed by vendors
    match /advertisingCampaigns/{campaignId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      
      // Vendor can create campaign for their own vendor identity, or admin
      allow create: if (
        isVendor() &&
        isValidId(campaignId) &&
        incoming().vendorId == request.auth.uid &&
        incoming().createdBy == request.auth.uid &&
        incoming().status in ['DRAFT', 'PENDING_APPROVAL']
      ) || isAdmin();
      
      // Vendor can only update their own campaign fields, never reassign vendorId
      allow update: if (
        isVendor() &&
        existing().vendorId == request.auth.uid &&
        incoming().vendorId == existing().vendorId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'campaignName', 'dailyBudget', 'totalBudget', 'cpc',
          'status', 'startDate', 'endDate', 'updatedAt'
        ])
      ) || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Advertising Wallets: Isolated prepaid balances (Vendors cannot tamper with balances)
    match /advertisingWallets/{walletId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      
      // Wallet creation initialized with 0 balance by vendor or by admin
      allow create: if (
        isVendor() &&
        isValidId(walletId) &&
        incoming().vendorId == request.auth.uid &&
        incoming().availableBalance == 0 &&
        incoming().totalDeposited == 0 &&
        incoming().totalSpent == 0 &&
        incoming().totalRefunded == 0
      ) || isAdmin();
      
      // Balances cannot be updated directly from client; only through Admin/Cloud Functions
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Advertising Transactions: Immutable ledger (Never overwrite, client write denied to vendors)
    match /advertisingTransactions/{txId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      
      // Authorized transaction creation by Admin / Cloud Functions only
      allow create: if isAdmin();
      // Historical financial transactions must be strictly immutable
      allow update, delete: if false;
    }

    // Advertising Clicks: Click tracking records
    match /advertisingClicks/{clickId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      
      // Click tracking written by system/admin; immutable records
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if false;
    }

    // Advertising Invalid Clicks: Fraud detection logs
    match /advertisingInvalidClicks/{invalidClickId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      
      // Written by fraud detection service/admin; immutable
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Advertising Audit Logs: Immutable security and administrative audit trail
    match /advertisingAuditLogs/{auditId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (isSignedIn() && incoming().actorId == request.auth.uid);
      allow update, delete: if false;
    }

    // Advertising Attributions: Immutable reporting metadata linking ad clicks to purchases
    match /advertisingAttributions/{attrId} {
      allow get: if isVendorOwner(existing().vendorId) || isAdmin();
      allow list: if (isVendor() && resource.data.vendorId == request.auth.uid) || isAdmin();
      // Reporting metadata: Cloud Functions / Server / Admin creation only
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // =========================================================================
    // LIVE GPS DELIVERY TRACKING (Strict Customer, Assigned Rider & Admin Isolation)
    // =========================================================================
    match /deliveryTracking/{orderId} {
      // Customer can view ONLY their own order tracking; Assigned Rider can view ONLY their assigned order; Admin/Staff allowed
      allow get: if isValidId(orderId) && (
        isAdmin() ||
        isStaff() ||
        (isSignedIn() && existing().customerId == request.auth.uid && existing().orderId == orderId) ||
        (isDeliveryPersonnel() && existing().deliveryPersonId == request.auth.uid)
      );

      // Admin list query MUST enforce isActive == true so completed/unrelated customer locations are never exposed
      allow list: if (isAdmin() && resource.data.isActive == true) ||
        (isSignedIn() && resource.data.customerId == request.auth.uid) ||
        (isDeliveryPersonnel() && resource.data.deliveryPersonId == request.auth.uid);

      // Creation allowed for Admin/Staff or Assigned Delivery Rider verified against authoritative orders/{orderId}
      allow create: if isValidId(orderId) && (
        isAdmin() ||
        isStaff() ||
        (isDeliveryPersonnel() &&
         incoming().orderId == orderId &&
         incoming().deliveryPersonId == request.auth.uid &&
         exists(/databases/$(database)/documents/orders/$(orderId)) &&
         get(/databases/$(database)/documents/orders/$(orderId)).data.get('assignedDeliveryId', '') == request.auth.uid &&
         get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == incoming().customerId)
      );

      // Updates:
      // 1) Admin / Staff
      // 2) Assigned Delivery Rider while order is not terminal (cannot forge customerLocation except scrubbing to null on delivery completion)
      // 3) Customer Owner ONLY to share/revoke their voluntary customerLocation while delivery is active
      allow update: if isValidId(orderId) && (
        isAdmin() ||
        isStaff() ||
        (
          isDeliveryPersonnel() &&
          existing().deliveryPersonId == request.auth.uid &&
          incoming().orderId == existing().orderId &&
          incoming().customerId == existing().customerId &&
          incoming().deliveryPersonId == existing().deliveryPersonId &&
          !(existing().orderStatus in ['DELIVERED', 'Delivered', 'CANCELLED', 'Cancelled', 'REFUNDED', 'Refunded']) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'riderLocation', 'trackingStatus', 'isActive', 'orderStatus',
            'routeSummary', 'lastUpdatedAt', 'stoppedAt', 'updatedAt',
            'customerLocation', 'customerSharingEnabled'
          ]) &&
          (
            incoming().get('riderLocation', null) == null ||
            isValidLatLng(incoming().riderLocation)
          ) &&
          (
            (incoming().orderStatus in ['DELIVERED', 'Delivered'] &&
             incoming().isActive == false &&
             incoming().get('customerLocation', null) == null &&
             incoming().get('customerSharingEnabled', false) == false) ||
            (
              incoming().get('customerLocation', null) == existing().get('customerLocation', null) &&
              incoming().get('customerSharingEnabled', false) == existing().get('customerSharingEnabled', false)
            )
          )
        ) ||
        (
          isSignedIn() &&
          existing().customerId == request.auth.uid &&
          existing().isActive == true &&
          !(existing().orderStatus in ['DELIVERED', 'Delivered', 'CANCELLED', 'Cancelled', 'REFUNDED', 'Refunded']) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['customerLocation', 'customerSharingEnabled', 'updatedAt']) &&
          (incoming().get('customerLocation', null) == null || isValidLatLng(incoming().customerLocation))
        )
      );

      allow delete: if isAdmin();
    }
  }
}
